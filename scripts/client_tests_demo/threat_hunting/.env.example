# Environment file for run_tests.sh — copy to .env.test and fill in.
#
# The runner accepts either `=` or `:` as the key/value delimiter; this example
# uses `=`. Lines starting with `#` and blank lines are ignored. Real .env*
# files are gitignored — only this .env.example is committed.
#
# A single account is used throughout (T1-T17): it needs threat-researcher or
# admin, since the demo creates a package, adds evidence, starts generation,
# manages a SIEM connector, and approves/reports — all writes. See "Session
# cookie" in docs/api-threat-hunting.md for the full role table.

# Target — choose ONE of the following:
#
#   1. host (+ optional port). Plain hostname or IP. `port` is OPTIONAL — when
#      omitted the scheme's default port applies (80 for http, 443 for https).
#      `host` may include a scheme; without one it defaults to http://.
#        host=192.0.2.10           + port=8000  -> http://192.0.2.10:8000
#        host=threats.example.com  (no port)    -> http://threats.example.com   (80)
#        host=https://threats.example.com       -> https://threats.example.com  (443)
#   2. url (full base URL, including scheme). Use this for a reverse proxy /
#      path prefix (alias) — e.g. https://proxy.example.com/opentars.
#
# If both are set, `url` wins and host/port are ignored (with a warning).
# A `url` MUST include the scheme (http:// or https://); a trailing slash is
# stripped. CLI: pass `--env <file>` to run_tests.sh.

host=192.0.2.10
port=8000

# HTTPS on the default port 443 (no port needed):
# host=https://threats.example.com

# Reverse-proxy alias / path prefix (full base URL incl. scheme):
# url=https://proxy.example.com/opentars

# TLS certificate verification — leave OFF unless you must accept a self-signed
# or otherwise untrusted cert. Truthy values: 1, true, yes, on. SECURITY: this
# disables cert validation for the whole run and exposes it to MITM; only use
# on trusted networks. Equivalent CLI flag: -k / --insecure
# skip_tls_verify=true

# Hunt account (threat-researcher or admin) — used for every test (T1-T17).
user_hunt=hunt-user
pass_hunt=changeme

# This demo runner always authenticates with a session login. To exercise the
# scoped API-key path instead (issue-local-029), call
# api_client_threat_hunting.py directly with --api-key '<client_id>.<secret>'
# — see this directory's README.md and docs/api-threat-hunting.md.
