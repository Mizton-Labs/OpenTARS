#!/usr/bin/env bash
# Enforces this repository's commit-authorship guideline: commit authorship
# stays with the human contributor only (see CONTRIBUTING.md).
#
# Setup (one-time, per clone): git config core.hooksPath .githooks

set -euo pipefail

msg_file="$1"

# Reject co-author trailers (this repo records a single human author) and any
# "<Something>-Session:" trailer. Both are matched as trailers — anchored to
# the start of a line — so ordinary prose in the body is never affected.
if grep -qiE '^[[:space:]]*co-authored-by:|^[[:space:]]*[A-Za-z][A-Za-z-]*-session:' "$msg_file"; then
  echo "commit-msg hook: rejected — commit message does not follow this repository's authorship guideline." >&2
  echo "Remove any additional authorship/session trailers and retry." >&2
  exit 1
fi
