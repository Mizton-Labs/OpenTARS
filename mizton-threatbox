#!/usr/bin/env bash
# Deprecated alias for ./opentars (issue-local-024 rebrand: Mizton-ThreatBox ->
# OpenTARS). Forwards every argument unchanged. Kept temporarily so already-
# deployed automation invoking the old script name (cron jobs, systemd units,
# container entrypoints) keeps working without an immediate coordinated
# update — see docs/rebranding-risk-analysis.md's Tier 3 discussion. Update
# any external automation to call ./opentars directly; this shim is slated
# for removal in a future release.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "[mizton-threatbox] deprecated: this script was renamed to ./opentars — update your automation to call it directly." >&2
exec "${SCRIPT_DIR}/opentars" "$@"
